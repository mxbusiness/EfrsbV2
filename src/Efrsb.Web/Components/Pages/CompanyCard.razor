@page "/companies/{CompanyId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using System.Xml.Linq
@using Efrsb.Application.Abstractions
@using Efrsb.Contracts.Companies
@using Efrsb.Contracts.Messages
@using Efrsb.Infrastructure.Jobs
@using Hangfire
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@inject ICompanyTrackingService CompanyService
@inject IBackgroundJobClient Jobs
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

@if (company is null && string.IsNullOrWhiteSpace(error))
{
    <section class="company-card-page">
        <div class="panel muted">Загрузка...</div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <section class="company-card-page">
        <div class="alert alert-error">@error</div>
        <a href="/companies" class="back-link">← К компаниям</a>
    </section>
}
else if (company is not null)
{
    <section class="company-card-page">
        <section class="hero-card">
            <div class="hero-main">
                <a href="/companies" class="back-link">← К компаниям</a>
                <div class="entity-kind">Юридическое лицо</div>
                <h1>@DisplayCompanyName(company)</h1>

                <div class="badge-row">
                    <span class="status-pill status-neutral">Юридическое лицо</span>
                    @if (IsBankrupt)
                    {
                        <span class="status-pill status-danger">Есть сведения о банкротстве</span>
                    }
                    else
                    {
                        <span class="status-pill status-success">Нет признаков банкротства</span>
                    }
                    @if (company.UnreadCount > 0)
                    {
                        <span class="status-pill status-warning">Непрочитанные: @company.UnreadCount</span>
                    }
                </div>
            </div>

            <div class="hero-actions" aria-label="Действия по компании">
                <a href="@($"/companies/{CompanyId}/messages")" class="btn btn-secondary">Все сообщения</a>
                <a href="@($"/companies/{CompanyId}/worksheet")" class="btn btn-secondary">Worksheet</a>
                <button class="btn btn-secondary" @onclick="MarkAllRead" disabled="@(isBusy || company.UnreadCount == 0)">Прочитать все</button>
                <button class="btn btn-primary" @onclick="Sync" disabled="@isBusy">Обновить</button>
                <button class="btn btn-primary" @onclick="SyncHistory" disabled="@isBusy">Догрузить историю</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <div class="alert alert-info">@status</div>
        }

        <section class="content-shell">
            <aside class="section-nav panel">
                <a href="#general">Общая информация</a>
                <a href="#publications">Публикации</a>
                <a href="#encumbrances">Обременения</a>
                <a href="#eio">ЕИО</a>
                <a href="#sro-info">Сведения о СРО</a>
                <a href="#sro-membership">Членство в СРО</a>
                <a href="#licenses">Лицензии</a>
                <a href="#net-assets">Стоимость чистых активов</a>
                <a href="#reorganization">Сведения о реорганизации</a>
                <a href="#bankruptcy">Сведения о банкротстве</a>
                <a href="@($"/companies/{CompanyId}/worksheet")">Worksheet</a>
                <a href="#trades">Торги</a>
            </aside>

            <main class="sections">
                <section id="general" class="panel section-panel">
                    <div class="section-heading">
                        <h2>Общая информация</h2>
                        <span class="muted">Карточка отслеживания и данные из публикаций ЕФРСБ</span>
                    </div>

                    <div class="identity-row">
                        <div class="identity-item">
                            <span>ИНН</span>
                            <strong>@Display(company.Inn)</strong>
                        </div>
                        <div class="identity-item">
                            <span>ОГРН</span>
                            <strong>@Display(company.Ogrn)</strong>
                        </div>
                        <div class="identity-item">
                            <span>КПП</span>
                            <strong>@UnavailableShort</strong>
                        </div>
                    </div>

                    <div class="definition-list fedresurs-like">
                        <div class="definition-row">
                            <div class="definition-label">Полное наименование</div>
                            <div class="definition-value">@Display(company.Name ?? company.SearchQuery)</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Уставный капитал</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Адрес по данным ЕГРЮЛ</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Дата регистрации</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Статус</div>
                            <div class="definition-value">@(IsBankrupt ? "Есть признаки процедуры банкротства по публикациям ЕФРСБ" : "Нет признаков банкротства в загруженных публикациях")</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Правовая форма (ОКОПФ)</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Вид деятельности (ОКВЭД)</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">BankruptGuid</div>
                            <div class="definition-value text-break">@Display(company.BankruptGuid)</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Первая публикация</div>
                            <div class="definition-value">@FormatDate(company.FirstMessageDate)</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Последняя публикация</div>
                            <div class="definition-value">@FormatDate(company.LastMessageDate)</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Последняя синхронизация</div>
                            <div class="definition-value">@FormatDate(company.LastSyncedAtUtc)</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Загружено в сервис</div>
                            <div class="definition-value">@company.LoadedMessages из @company.TotalMessages (service_rest)</div>
                        </div>
                    </div>
                </section>

                <section id="publications" class="panel section-panel">
                    <div class="section-heading">
                        <div>
                            <h2>Публикации</h2>
                            <div class="section-subtitle">О лице</div>
                        </div>
                        <span class="muted">Последние 3 сообщения</span>
                    </div>

                    @RenderMessageList(Messages.Take(3).ToList(), "Публикаций пока нет.", true)

                    @if (Messages.Count > 3)
                    {
                        <div class="section-footer-link">
                            <a href="@($"/companies/{CompanyId}/messages")">Вся информация →</a>
                        </div>
                    }
                </section>

                <section id="encumbrances" class="panel section-panel">
                    <h2>Обременения</h2>
                    <p class="muted-block">Нет данных. В текущем REST API ЕФРСБ нет отдельного метода для публичного блока «Обременения».</p>
                </section>

                <section id="eio" class="panel section-panel">
                    <h2>Единоличный исполнительный орган</h2>
                    <div class="definition-list small-list">
                        <div class="definition-row">
                            <div class="definition-label">ФИО</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">ИНН</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Должность</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                        <div class="definition-row">
                            <div class="definition-label">Дата внесения данных в ЕГРЮЛ</div>
                            <div class="definition-value muted">@UnavailableText</div>
                        </div>
                    </div>
                </section>

                <section id="sro-info" class="panel section-panel">
                    <h2>Сведения о СРО</h2>
                    <p class="muted-block">Нет данных.</p>
                </section>

                <section id="sro-membership" class="panel section-panel">
                    <h2>Членство в СРО</h2>
                    <p class="muted-block">Нет данных.</p>
                </section>

                <section id="licenses" class="panel section-panel">
                    <h2>Лицензии</h2>
                    <p class="muted-block">Нет данных. Лицензии не входят в текущий набор методов service_rest.</p>
                </section>

                <section id="net-assets" class="panel section-panel">
                    <h2>Стоимость чистых активов</h2>
                    <p class="muted-block">Нет данных. Блок отсутствует в текущем REST API ЕФРСБ.</p>
                </section>

                <section id="reorganization" class="panel section-panel">
                    <h2>Сведения о реорганизации</h2>
                    <p class="muted-block">Нет данных.</p>
                </section>

                <section id="bankruptcy" class="panel section-panel">
                    <div class="section-heading">
                        <div>
                            <h2>Сведения о банкротстве</h2>
                            <div class="section-subtitle">Публикации разделены по смысловым группам</div>
                        </div>
                        @if (IsBankrupt)
                        {
                            <span class="status-pill status-danger">Банкротные публикации найдены</span>
                        }
                    </div>

                    @if (BankruptcyMessages.Count == 0)
                    {
                        <p class="muted-block">Нет данных.</p>
                    }
                    else
                    {
                        <div class="bankruptcy-summary">
                            <div>
                                <span class="summary-label">Публикаций</span>
                                <strong>@BankruptcyMessages.Count</strong>
                            </div>
                            <div>
                                <span class="summary-label">Последняя</span>
                                <strong>@FormatDate(BankruptcyMessages.FirstOrDefault()?.DatePublish)</strong>
                            </div>
                        </div>

                        @foreach (var group in BankruptcyGroups)
                        {
                            <div class="bankruptcy-group">
                                <div class="bankruptcy-group-head">
                                    <div>
                                        <h3>@group.Title</h3>
                                        @if (!string.IsNullOrWhiteSpace(group.CaseNumber))
                                        {
                                            <div class="case-number">@group.CaseNumber</div>
                                        }
                                    </div>
                                    <span class="muted">@group.Items.Count сообщений</span>
                                </div>
                                @RenderMessageList(group.Items.Take(3).ToList(), "Нет данных", true)
                            </div>
                        }

                        <div class="section-footer-link">
                            <a href="@($"/companies/{CompanyId}/messages")">Все банкротные сообщения →</a>
                        </div>
                    }
                </section>

                <section id="trades" class="panel section-panel">
                    <div class="section-heading">
                        <div>
                            <h2>Торги</h2>
                            <div class="section-subtitle">Сообщения о продаже имущества и результатах торгов</div>
                        </div>
                    </div>

                    <div class="trade-group">
                        <h3>Продажа имущества при банкротстве</h3>
                        @RenderMessageList(TradeMessages.Take(3).ToList(), "Нет данных", true)
                    </div>

                    <div class="divider"></div>

                    <div class="trade-group">
                        <h3>Залоговое имущество</h3>
                        <p class="muted-block">Нет данных.</p>
                    </div>

                    <div class="divider"></div>

                    <div class="trade-group">
                        <h3>Права требований</h3>
                        <p class="muted-block">Нет данных.</p>
                    </div>
                </section>
            </main>
        </section>
    </section>
}

@code {
    [Parameter]
    public Guid CompanyId { get; set; }

    private const string UnavailableShort = "Нет данных";
    private const string UnavailableText = "Нет данных в текущем service_rest";

    private TrackedCompanyDto? company;
    private IReadOnlyList<EfrsbMessageDto>? messages;
    private readonly Dictionary<Guid, EfrsbMessageDetailsDto> detailsCache = new();
    private string? error;
    private string? status;
    private bool isBusy;
    private CancellationTokenSource? refreshCts;
    private bool disposed;
    private DateTime autoRefreshUntilUtc = DateTime.UtcNow.AddMinutes(1);

    private IReadOnlyList<EfrsbMessageDto> Messages => messages?.OrderByDescending(m => m.DatePublish).ToList() ?? [];

    private IReadOnlyList<EfrsbMessageDto> BankruptcyMessages => Messages
        .Where(IsBankruptcyMessage)
        .ToList();

    private IReadOnlyList<EfrsbMessageDto> TradeMessages => Messages
        .Where(IsTradeMessage)
        .ToList();

    private IReadOnlyList<BankruptcyGroup> BankruptcyGroups => BuildBankruptcyGroups();

    private bool IsBankrupt => BankruptcyMessages.Count > 0;

    private static readonly HashSet<string> BankruptcyTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "ArbitralDecree",
        "CourtAcceptanceStatement",
        "CourtAssertAcceptance",
        "DemandAnnouncement",
        "ReceivingCreditorDemand",
        "ReceivingCreditorDemand2",
        "CreditorsDemandRegistered",
        "StartOfExtrajudicialBankruptcy",
        "TerminationOfExtrajudicialBankruptcy",
        "CompletionOfExtrajudicialBankruptcy",
        "InformationAboutBankruptcy",
        "Final",
        "Final2"
    };

    private static readonly HashSet<string> TradeTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Auction",
        "Auction2",
        "ChangeAuction",
        "ChangeAuction2",
        "TradeResult",
        "SaleContractResult",
        "SaleContractResult2",
        "SaleOrderPledgedProperty",
        "SaleOrderPledgedProperty2",
        "CancelAuctionTradeResult"
    };

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshCts = new CancellationTokenSource();
        _ = RefreshLoop(refreshCts.Token);
    }

    public void Dispose()
    {
        disposed = true;
        refreshCts?.Cancel();
        refreshCts?.Dispose();
    }

    private async Task<Guid> GetUserId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var value = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(value))
            throw new InvalidOperationException("Пользователь не авторизован.");

        return Guid.Parse(value);
    }

    private async Task RefreshLoop(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && !disposed)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);

                if (cancellationToken.IsCancellationRequested || disposed)
                    break;

                if (!ShouldPoll())
                    continue;

                await InvokeAsync(async () =>
                {
                    if (disposed)
                        return;

                    await Load(silent: true);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Автообновление не должно ронять страницу.
            }
        }
    }

    private bool ShouldPoll()
    {
        if (isBusy || DateTime.UtcNow <= autoRefreshUntilUtc)
            return true;

        return company is not null && company.TotalMessages > 0 && company.LoadedMessages < company.TotalMessages;
    }

    private async Task Load(bool silent = false)
    {
        if (!silent)
            error = null;

        detailsCache.Clear();

        try
        {
            var userId = await GetUserId();
            var companies = await CompanyService.GetCompaniesAsync(userId, CancellationToken.None);
            company = companies.FirstOrDefault(x => x.Id == CompanyId);

            if (company is null)
            {
                if (!silent)
                    error = "Компания не найдена или нет доступа.";
                return;
            }

            messages = await CompanyService.GetMessagesAsync(userId, CompanyId, CancellationToken.None);
            await LoadDetailsPreview(userId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (!silent)
                error = ex.Message;
        }
    }

    private async Task LoadDetailsPreview(Guid userId, CancellationToken cancellationToken)
    {
        foreach (var item in Messages.Where(IsBankruptcyMessage).Take(30))
        {
            var details = await CompanyService.GetMessageDetailsAsync(userId, item.Id, cancellationToken);
            if (details is not null)
                detailsCache[item.Id] = details;
        }
    }

    private async Task MarkAllRead()
    {
        error = null;
        isBusy = true;
        status = "Помечаем сообщения прочитанными...";

        try
        {
            var userId = await GetUserId();
            var changed = await CompanyService.MarkCompanyMessagesReadAsync(userId, CompanyId, CancellationToken.None);
            status = changed == 0
                ? "Непрочитанных сообщений не было."
                : $"Прочитано сообщений: {changed}.";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task Sync()
    {
        error = null;
        isBusy = true;
        status = "Синхронизация свежих сообщений...";

        try
        {
            var userId = await GetUserId();
            var companyId = CompanyId;
            autoRefreshUntilUtc = DateTime.UtcNow.AddMinutes(5);
            Jobs.Enqueue<FedresursSyncJob>(job => job.SyncCompanyAsync(userId, companyId));
            status = "Синхронизация свежих сообщений запущена в фоне.";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SyncHistory()
    {
        error = null;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Догрузить всю историю сообщений по компании? Это может занять некоторое время.");

        if (!confirmed)
            return;

        isBusy = true;
        status = "Догружаем историю сообщений...";

        try
        {
            var userId = await GetUserId();
            var companyId = CompanyId;
            autoRefreshUntilUtc = DateTime.UtcNow.AddMinutes(10);
            Jobs.Enqueue<FedresursSyncJob>(job => job.SyncCompanyHistoryAsync(userId, companyId));
            status = "Догрузка истории запущена в фоне. Можно уйти со страницы — задача продолжится.";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private IReadOnlyList<BankruptcyGroup> BuildBankruptcyGroups()
    {
        var order = new[]
        {
            "Конкурсное производство",
            "Сообщения о намерении",
            "Требования кредиторов",
            "Внесудебное банкротство",
            "Иные банкротные сведения"
        };

        return BankruptcyMessages
            .GroupBy(GetBankruptcyGroupTitle)
            .OrderBy(g => Array.IndexOf(order, g.Key) < 0 ? order.Length : Array.IndexOf(order, g.Key))
            .ThenBy(g => g.Key)
            .Select(g => new BankruptcyGroup(
                g.Key,
                g.Select(GetCaseNumber).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                g.OrderByDescending(x => x.DatePublish).ToList()))
            .ToList();
    }

    private RenderFragment RenderMessageList(IReadOnlyList<EfrsbMessageDto> items, string emptyText, bool showMeta = false) => builder =>
    {
        var seq = 0;
        if (items.Count == 0)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "muted-block");
            builder.AddContent(seq++, emptyText);
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "publication-list");

        foreach (var item in items)
        {
            var rowClasses = "publication-row";
            if (!item.IsRead)
                rowClasses += " publication-unread";
            if (item.IsAnnulled)
                rowClasses += " publication-annulled";
            if (item.IsLocked)
                rowClasses += " publication-locked";

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", rowClasses);

            builder.OpenElement(seq++, "a");
            builder.AddAttribute(seq++, "href", $"/messages/{item.Id}");
            builder.AddAttribute(seq++, "class", "publication-number");
            builder.AddContent(seq++, $"{item.Number} от {item.DatePublish.ToLocalTime():dd.MM.yyyy}");
            builder.CloseElement();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "publication-body");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "publication-title");
            builder.AddContent(seq++, GetTypeTitle(item.Type, item.CourtDecisionType));
            builder.CloseElement();

            if (showMeta)
            {
                var caseNumber = GetCaseNumber(item);
                if (!string.IsNullOrWhiteSpace(caseNumber))
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "class", "publication-meta");
                    builder.AddContent(seq++, caseNumber);
                    builder.CloseElement();
                }
            }

            if (item.HasViolation == true || item.IsLocked || item.IsAnnulled || !item.IsRead)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "publication-flags");

                if (!item.IsRead)
                    AddFlag(builder, ref seq, "Не прочитано");
                if (item.HasViolation == true)
                    AddFlag(builder, ref seq, "Нарушение срока");
                if (item.IsLocked)
                    AddFlag(builder, ref seq, "Заблокировано");
                if (item.IsAnnulled)
                    AddFlag(builder, ref seq, "Аннулировано");

                builder.CloseElement();
            }

            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static void AddFlag(RenderTreeBuilder builder, ref int seq, string text)
    {
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "publication-flag");
        builder.AddContent(seq++, text);
        builder.CloseElement();
    }

    private static bool IsBankruptcyMessage(EfrsbMessageDto message)
    {
        var title = GetTypeTitle(message.Type, message.CourtDecisionType);

        return IsReportType(message.Type)
            || BankruptcyTypes.Contains(message.Type)
            || message.Type.Contains("Bankruptcy", StringComparison.OrdinalIgnoreCase)
            || message.Type.Contains("Creditor", StringComparison.OrdinalIgnoreCase)
            || message.Type.Contains("Demand", StringComparison.OrdinalIgnoreCase)
            || title.Contains("банкрот", StringComparison.OrdinalIgnoreCase)
            || title.Contains("требован", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsTradeMessage(EfrsbMessageDto message)
    {
        var title = GetTypeTitle(message.Type, message.CourtDecisionType);

        return TradeTypes.Contains(message.Type)
            || message.Type.Contains("Auction", StringComparison.OrdinalIgnoreCase)
            || message.Type.Contains("Trade", StringComparison.OrdinalIgnoreCase)
            || message.Type.Contains("Sale", StringComparison.OrdinalIgnoreCase)
            || title.Contains("торг", StringComparison.OrdinalIgnoreCase)
            || title.Contains("продаж", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetBankruptcyGroupTitle(EfrsbMessageDto item)
    {
        if (IsReportType(item.Type))
            return "Конкурсное производство";

        var title = GetTypeTitle(item.Type, item.CourtDecisionType);
        if (title.Contains("намерен", StringComparison.OrdinalIgnoreCase)
            || title.Contains("намерени", StringComparison.OrdinalIgnoreCase)
            || title.Contains("обратиться в суд с заявлением о банкротстве", StringComparison.OrdinalIgnoreCase))
            return "Сообщения о намерении";

        if (title.Contains("требован", StringComparison.OrdinalIgnoreCase)
            || title.Contains("реестр требований", StringComparison.OrdinalIgnoreCase))
            return "Требования кредиторов";

        return item.Type switch
        {
        "ArbitralDecree" or "InformationAboutBankruptcy" or "Final" or "Final2" => "Конкурсное производство",
        "DemandAnnouncement" or "CourtAssertAcceptance" or "CourtAcceptanceStatement" or "IntentionCreditOrg" or "IntentionOfDemandsFulfilment" or "IntentionOfDemandsFulfilmentReview" => "Сообщения о намерении",
        "ReceivingCreditorDemand" or "ReceivingCreditorDemand2" or "CreditorsDemandRegistered" => "Требования кредиторов",
        "StartOfExtrajudicialBankruptcy" or "TerminationOfExtrajudicialBankruptcy" or "CompletionOfExtrajudicialBankruptcy" => "Внесудебное банкротство",
        _ => "Иные банкротные сведения"
        };
    }

    private string? GetCaseNumber(EfrsbMessageDto item)
    {
        return TryGetXmlValue(
            item.Id,
            "CaseNumber",
            "caseNumber",
            "LegalCaseNumber",
            "CourtCaseNumber",
            "ArbitrationCaseNumber",
            "ArbitrationCaseNo");
    }

    private string? TryGetXmlValue(Guid messageId, params string[] localNames)
    {
        if (!detailsCache.TryGetValue(messageId, out var details) || string.IsNullOrWhiteSpace(details.ContentXml))
            return null;

        try
        {
            var names = new HashSet<string>(localNames, StringComparer.OrdinalIgnoreCase);
            var doc = XDocument.Parse(details.ContentXml);
            var value = doc
                .Descendants()
                .FirstOrDefault(x => names.Contains(x.Name.LocalName))
                ?.Value
                ?.Trim();

            return string.IsNullOrWhiteSpace(value) ? null : value;
        }
        catch
        {
            return null;
        }
    }

    private static string GetTypeTitle(string type, string? detail = null)
    {
        if (IsPublicType(type))
            return !string.IsNullOrWhiteSpace(detail)
                ? detail
                : type["Public:".Length..];

        if (IsReportType(type))
        {
            var reportType = type.StartsWith("Report:", StringComparison.OrdinalIgnoreCase)
                ? type["Report:".Length..]
                : type;

            var reportTitle = reportType switch
            {
                "Final" or "Final2" => "Финальный отчет",
                "Annulment" or "Annulment2" => "Аннулирование ранее опубликованного отчета",
                "SignificantEvent" => "Отчет по существенным фактам",
                "Periodic" => "Периодический отчет",
                _ => reportType
            };

            var procedureTitle = GetProcedureTypeTitle(detail);
            return string.IsNullOrWhiteSpace(procedureTitle)
                ? reportTitle
                : $"{reportTitle}. {procedureTitle}";
        }

        var title = type switch
        {
            "ArbitralDecree" => "Сообщение о судебном акте",
            "Auction" or "Auction2" => "Объявление о проведении торгов",
            "ChangeAuction" or "ChangeAuction2" => "Сообщение об изменении объявления о проведении торгов",
            "TradeResult" => "Сообщение о результатах торгов",
            "Meeting" or "Meeting2" => "Сообщение о собрании кредиторов",
            "MeetingResult" => "Сообщение о результатах проведения собрания кредиторов",
            "Committee" or "Committee2" => "Уведомление о проведении комитета кредиторов",
            "CommitteeResult" => "Сообщение о результатах проведения комитета кредиторов",
            "Annul" => "Аннулирование ранее опубликованного сообщения",
            "SaleContractResult" or "SaleContractResult2" => "Сведения о заключении договора купли-продажи",
            "PropertyInventoryResult" => "Сведения о результатах инвентаризации имущества должника",
            "PropertyEvaluationReport" or "AssessmentReport" => "Отчет оценщика об оценке имущества должника",
            "DealInvalid" or "DealInvalid2" => "Заявление о признании сделки должника недействительной",
            "DealInvalidResult" or "DealInvalidResult2" => "Результаты рассмотрения/пересмотра заявлений об оспаривании сделок",
            "DeclarationPersonDamages" => "Заявление о привлечении контролирующих должника лиц, а также иных лиц, к ответственности в виде возмещения убытков",
            "ActPersonDamages" or "ActReviewPersonDamages" => "Судебный акт по заявлению о привлечении к ответственности в виде возмещения убытков",
            "DeclarationPersonSubsidiary" => "Заявление о привлечении контролирующих должника лиц к субсидиарной ответственности",
            "ActPersonSubsidiary" or "ActPersonSubsidiary2" => "Судебный акт по заявлению о привлечении к субсидиарной ответственности",
            "ActReviewPersonSubsidiary" or "ActReviewPersonSubsidiary2" => "Судебный акт по пересмотру заявления о привлечении к субсидиарной ответственности",
            "ReceivingCreditorDemand" or "ReceivingCreditorDemand2" => "Уведомление о получении требований кредитора",
            "CreditorsDemandRegistered" => "Сообщение о включении заявленных требований в реестр требований кредиторов",
            "DemandAnnouncement" => "Извещение о возможности предъявления требований",
            "CourtAssertAcceptance" => "Объявление о принятии арбитражным судом заявления",
            "CourtAcceptanceStatement" => "Сведения о принятии заявления о признании должника банкротом",
            "InformationAboutBankruptcy" => "Информация о ходе конкурсного производства",
            "MeetingWorker" or "MeetingWorker2" => "Уведомление о проведении собрания работников, бывших работников должника",
            "MeetingWorkerResult" => "Сведения о решениях, принятых собранием работников, бывших работников должника",
            "MeetingParticipantsBuilding" or "MeetingParticipantsBuilding2" => "Уведомление о проведении собрания участников строительства",
            "MeetingPartBuildResult" => "Сообщение о результатах проведения собрания участников строительства",
            "StartOfExtrajudicialBankruptcy" => "Сообщение о возбуждении процедуры внесудебного банкротства гражданина",
            "TerminationOfExtrajudicialBankruptcy" => "Сообщение о прекращении процедуры внесудебного банкротства гражданина",
            "CompletionOfExtrajudicialBankruptcy" => "Сообщение о завершении процедуры внесудебного банкротства гражданина",
            "Final" or "Final2" => "Финальный отчет",
            _ => type
        };

        var courtDecisionTitle = GetCourtDecisionTypeTitle(detail);
        return type.Equals("ArbitralDecree", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(courtDecisionTitle)
            ? $"{title}. {courtDecisionTitle}"
            : title;
    }

    private static string? GetCourtDecisionTypeTitle(string? type) => type switch
    {
        "ExternalManagement" => "о введении внешнего управления",
        "ChangeCourtAct" => "об отмене или изменении судебных актов",
        "LegalCaseResume" => "о возобновлении производства по делу о несостоятельности (банкротстве)",
        "ArbitrManagerApproval" => "об утверждении арбитражного управляющего",
        "ArbitrManagerRelease" => "об освобождении или отстранении арбитражного управляющего",
        "Receivership" => "о признании должника банкротом и открытии конкурсного производства",
        "LegalCaseTermination" => "о прекращении производства по делу",
        "FinancialRecovery" => "о введении финансового оздоровления",
        "BankruptcyRefusal" => "об отказе в признании должника банкротом",
        "Observation" => "о введении наблюдения",
        "OtherAct" => "Другие судебные акты",
        "OtherDefinition" => "Другие определения",
        "ThirdPartyPayoffRequestApproval" => "об удовлетворении заявлений третьих лиц о намерении погасить обязательства должника",
        "DebtRestructuring" => "о признании обоснованным заявления о признании гражданина банкротом и введении реструктуризации его долгов",
        "PropertySale" => "о признании гражданина банкротом и введении реализации имущества гражданина",
        "DebtRestructuringPlan" => "об утверждении плана реструктуризации долгов гражданина",
        "DebtRestructuringComplete" => "о завершении реструктуризации долгов гражданина",
        "ArbitrManagerActionsIllegal" => "о признании действий арбитражного управляющего незаконными",
        "ArbitrManagerLossesRecovery" => "о взыскании с арбитражного управляющего убытков",
        "ObligationsDischargeRefusal" => "о неприменении правила об освобождении от исполнения обязательств",
        "PropertySaleComplete" => "о завершении реализации имущества гражданина",
        "DeveloperBankruptcy" => "о применении правил банкротства застройщиков",
        "CaseTransfer" => "о передаче дела на рассмотрение другого арбитражного суда",
        "LegalCaseEnd" => "о завершении конкурсного производства",
        "ExtensionProcedure" => "о продлении срока процедуры",
        "ChangeArbitralDecree" => "об изменении судебного акта",
        "CancelArbitralDecree" => "об отмене судебного акта",
        _ => null
    };

    private static string? GetProcedureTypeTitle(string? type) => type switch
    {
        "FinancialRecovery" => "Финансовое оздоровление",
        "ExternalManagement" => "Внешнее управление",
        "Tender" => "Конкурсное производство",
        "Watching" => "Наблюдение",
        "CitizenAssetsDisposal" => "Реализация имущества гражданина",
        "CitizenDebtRestructuring" => "Реструктуризация долгов гражданина",
        _ => null
    };

    private static bool IsReportType(string type)
    {
        return type.StartsWith("Report", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsPublicType(string type)
    {
        return type.StartsWith("Public:", StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayCompanyName(TrackedCompanyDto company)
    {
        if (!string.IsNullOrWhiteSpace(company.Name))
            return company.Name;

        if (!string.IsNullOrWhiteSpace(company.Inn))
            return company.Inn;

        if (!string.IsNullOrWhiteSpace(company.Ogrn))
            return company.Ogrn;

        return company.SearchQuery;
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Нет данных" : value;

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue ? value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Нет данных";
    }

    private sealed record BankruptcyGroup(string Title, string? CaseNumber, IReadOnlyList<EfrsbMessageDto> Items);
}

