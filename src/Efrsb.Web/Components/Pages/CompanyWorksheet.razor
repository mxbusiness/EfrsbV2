        };
    }

    private async Task EnsureWorksheetScript()
    {
        const string script = @"
        if (!window.efrsbWorksheet2d) {
            window.efrsbWorksheet2d = {
                init: function(containerId) {
                    var root = document.getElementById(containerId);
                    if (!root) return;

                    var viewport = root;
                    var canvas = root.querySelector('[data-ws-canvas]');
                    var svg = root.querySelector('[data-ws-edges]');
                    var viewKey = root.getAttribute('data-ws-view-key');
                    if (!canvas) return;

                    function getView() {
                        var fallback = { x: 20, y: 20, scale: 0.82 };
                        try {
                            var saved = localStorage.getItem(viewKey);
                            if (!saved) return fallback;
                            var parsed = JSON.parse(saved);
                            if (!parsed || typeof parsed.scale !== 'number') return fallback;
                            return parsed;
                        } catch (_) {
                            return fallback;
                        }
                    }

                    function saveView(view) {
                        localStorage.setItem(viewKey, JSON.stringify(view));
                    }

                    var view = getView();

                    function applyView() {
                        canvas.style.transform = 'translate(' + view.x + 'px,' + view.y + 'px) scale(' + view.scale + ')';
                        canvas.style.transformOrigin = '0 0';
                    }

                    function cardCenter(card, side) {
                        var left = parseFloat(card.style.left || '0') || 0;
                        var top = parseFloat(card.style.top || '0') || 0;
                        var width = card.offsetWidth || 300;
                        var height = card.offsetHeight || 200;
                        if (side === 'left') return { x: left, y: top + height / 2 };
                        if (side === 'right') return { x: left + width, y: top + height / 2 };
                        return { x: left + width / 2, y: top + height / 2 };
                    }

                    function updateEdges() {
                        if (!svg) return;
                        svg.querySelectorAll('[data-ws-edge]').forEach(function(edge) {
                            var from = canvas.querySelector('[data-ws-node-id=""' + edge.getAttribute('data-from') + '""]');
                            var to = canvas.querySelector('[data-ws-node-id=""' + edge.getAttribute('data-to') + '""]');
                            if (!from || !to) return;

                            var a = cardCenter(from, 'right');
                            var b = cardCenter(to, 'left');
                            var dx = Math.max(80, Math.abs(b.x - a.x) * 0.42);
                            var path = 'M ' + a.x + ' ' + a.y + ' C ' + (a.x + dx) + ' ' + a.y + ', ' + (b.x - dx) + ' ' + b.y + ', ' + b.x + ' ' + b.y;
                            edge.setAttribute('d', path);
                        });
                    }

                    root.querySelectorAll('[data-ws-note]').forEach(function(el) {
                        if (el.dataset.wsNoteReady === '1') return;
                        el.dataset.wsNoteReady = '1';
                        var key = el.getAttribute('data-ws-note');
                        var saved = localStorage.getItem(key);
                        if (saved !== null) el.value = saved;
                        el.addEventListener('input', function() {
                            localStorage.setItem(key, el.value || '');
                        });
                    });

                    root.querySelectorAll('[data-ws-card]').forEach(function(card) {
                        var key = card.getAttribute('data-ws-position-key');
                        var saved = localStorage.getItem(key);
                        if (saved) {
                            try {
                                var pos = JSON.parse(saved);
                                if (typeof pos.x === 'number') card.style.left = pos.x + 'px';
                                if (typeof pos.y === 'number') card.style.top = pos.y + 'px';
                                card.classList.add('is-moved');
                            } catch (_) {}
                        }

                        if (card.dataset.wsDragReady === '1') return;
                        card.dataset.wsDragReady = '1';

                        var startX = 0, startY = 0, baseX = 0, baseY = 0, moving = false;

                        card.addEventListener('pointerdown', function(e) {
                            if (e.target && ['TEXTAREA', 'A', 'BUTTON', 'SELECT', 'INPUT'].indexOf(e.target.tagName) >= 0) return;
                            moving = true;
                            startX = e.clientX;
                            startY = e.clientY;
                            baseX = parseFloat(card.style.left || '0') || 0;
                            baseY = parseFloat(card.style.top || '0') || 0;
                            card.setPointerCapture(e.pointerId);
                            card.classList.add('is-dragging');
                            e.preventDefault();
                        });

                        card.addEventListener('pointermove', function(e) {
                            if (!moving) return;
                            var x = baseX + (e.clientX - startX) / view.scale;
                            var y = baseY + (e.clientY - startY) / view.scale;
                            card.style.left = x + 'px';
                            card.style.top = y + 'px';
                            card.classList.add('is-moved');
                            updateEdges();
                        });

                        card.addEventListener('pointerup', function(e) {
                            if (!moving) return;
                            moving = false;
                            card.classList.remove('is-dragging');
                            var x = parseFloat(card.style.left || '0') || 0;
                            var y = parseFloat(card.style.top || '0') || 0;
                            localStorage.setItem(key, JSON.stringify({ x: x, y: y }));
                            try { card.releasePointerCapture(e.pointerId); } catch (_) {}
                            updateEdges();
                        });
                    });

                    if (viewport.dataset.wsPanReady !== '1') {
                        viewport.dataset.wsPanReady = '1';
                        var panning = false, panStartX = 0, panStartY = 0, panBaseX = 0, panBaseY = 0;

                        viewport.addEventListener('pointerdown', function(e) {
                            var isEmpty = e.target === viewport || e.target === canvas || e.target === svg || e.target.classList.contains('ws-group-panel');
                            if (!isEmpty) return;
                            panning = true;
                            panStartX = e.clientX;
                            panStartY = e.clientY;
                            panBaseX = view.x;
                            panBaseY = view.y;
                            viewport.setPointerCapture(e.pointerId);
                            viewport.classList.add('is-panning');
                        });

                        viewport.addEventListener('pointermove', function(e) {
                            if (!panning) return;
                            view.x = panBaseX + e.clientX - panStartX;
                            view.y = panBaseY + e.clientY - panStartY;
                            applyView();
                        });

                        viewport.addEventListener('pointerup', function(e) {
                            if (!panning) return;
                            panning = false;
                            viewport.classList.remove('is-panning');
                            saveView(view);
                            try { viewport.releasePointerCapture(e.pointerId); } catch (_) {}
                        });

                        viewport.addEventListener('wheel', function(e) {
                            e.preventDefault();
                            var rect = viewport.getBoundingClientRect();
                            var mouseX = e.clientX - rect.left;
                            var mouseY = e.clientY - rect.top;
                            var oldScale = view.scale;
                            var factor = e.deltaY < 0 ? 1.08 : 0.92;
                            var nextScale = Math.max(0.25, Math.min(1.8, oldScale * factor));
                            var worldX = (mouseX - view.x) / oldScale;
                            var worldY = (mouseY - view.y) / oldScale;
                            view.scale = nextScale;
                            view.x = mouseX - worldX * nextScale;
                            view.y = mouseY - worldY * nextScale;
                            applyView();
                            saveView(view);
                        }, { passive: false });
                    }

                    applyView();
                    setTimeout(updateEdges, 0);
                    setTimeout(updateEdges, 250);
                },
                resetPositions: function(containerId) {
                    var root = document.getElementById(containerId);
                    if (!root) return;
                    root.querySelectorAll('[data-ws-card]').forEach(function(card) {
                        var key = card.getAttribute('data-ws-position-key');
                        localStorage.removeItem(key);
                        card.style.left = (card.getAttribute('data-ws-default-left') || '0') + 'px';
                        card.style.top = (card.getAttribute('data-ws-default-top') || '0') + 'px';
                        card.classList.remove('is-moved');
                    });
                    setTimeout(function() { window.efrsbWorksheet2d.init(containerId); }, 0);
                },
                resetView: function(containerId) {
                    var root = document.getElementById(containerId);
                    if (!root) return;
                    var viewKey = root.getAttribute('data-ws-view-key');
                    localStorage.removeItem(viewKey);
                    window.efrsbWorksheet2d.init(containerId);
                },
                fit: function(containerId) {
                    var root = document.getElementById(containerId);
                    if (!root) return;
                    var canvas = root.querySelector('[data-ws-canvas]');
                    if (!canvas) return;
                    var viewKey = root.getAttribute('data-ws-view-key');
                    var scale = Math.max(0.25, Math.min(1, (root.clientWidth - 80) / Math.max(800, canvas.offsetWidth)));
                    var view = { x: 40, y: 40, scale: scale };
                    localStorage.setItem(viewKey, JSON.stringify(view));
                    canvas.style.transform = 'translate(' + view.x + 'px,' + view.y + 'px) scale(' + view.scale + ')';
                    canvas.style.transformOrigin = '0 0';
                    setTimeout(function() { window.efrsbWorksheet2d.init(containerId); }, 0);
                }
            };
        }
        ";

        if (!scriptReady)
        {
            await JS.InvokeVoidAsync("eval", script);
            scriptReady = true;
        }
    }

    private sealed record NodeSize(int Width, int Height);

    private sealed record WorksheetNode(
        string NodeId,
        EfrsbMessageDto Message,
        string Group,
        string Title,
        int X,
        int Y,
        int Width,
        int Height,
        string NoteKey,
        string PositionKey,
        string CssClass,
        int Sequence);

    private sealed record WorksheetEdge(string FromNodeId, string ToNodeId, string CssClass);

    private sealed record WorksheetGroupPanel(
        string Title,
        int X,
        int Y,
        int Width,
        int Height,
        int Count,
        string CssClass);
}

