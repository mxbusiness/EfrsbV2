@page "/companies/{CompanyId:guid}/worksheet"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Efrsb.Application.Abstractions
@using Efrsb.Contracts.Companies
@using Efrsb.Contracts.Messages
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject ICompanyTrackingService CompanyService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<div class="worksheet-page">
    @if (company is null && string.IsNullOrWhiteSpace(error))
    {
        <div class="worksheet-loading">Загрузка рабочей области...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="worksheet-error">
            <h2>Ошибка</h2>
            <p>@error</p>
            <a class="ws-btn ws-btn-secondary" href="/companies">← К компаниям</a>
        </div>
    }
    else if (company is not null)
    {
        var nodes = Nodes;
        var edges = Edges(nodes);

        <section class="ws-header">
            <div class="ws-header-left">
                <a class="ws-back" href="@($"/companies/{CompanyId}")">← К карточке компании</a>
                <div class="ws-kicker">2D рабочая область дела</div>
                <h1>Worksheet</h1>
                <div class="ws-company-name">@DisplayCompanyName(company)</div>
            </div>

            <div class="ws-header-actions">
                <a class="ws-btn ws-btn-secondary" href="@($"/companies/{CompanyId}/messages")">Все сообщения</a>
                <button class="ws-btn ws-btn-secondary" @onclick="MarkAllRead" disabled="@(isBusy || company.UnreadCount == 0)">Прочитать все</button>
                <button class="ws-btn ws-btn-secondary" @onclick="ResetPositions">Сбросить карточки</button>
                <button class="ws-btn ws-btn-secondary" @onclick="ResetView">Сбросить вид</button>
                <button class="ws-btn ws-btn-primary" @onclick="FitView">Показать всё</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <div class="ws-status">@status</div>
        }

        <section class="ws-summary">
            <div class="ws-stat">
                <span>Загружено</span>
                <strong>@company.LoadedMessages / @company.TotalMessages</strong>
                <small>service_rest</small>
            </div>
            <div class="ws-stat">
                <span>Непрочитанные</span>
                <strong>@company.UnreadCount</strong>
                <small>для текущего пользователя</small>
            </div>
            <div class="ws-stat">
                <span>Период</span>
                <strong>@FormatDate(company.FirstMessageDate) — @FormatDate(company.LastMessageDate)</strong>
                <small>по загруженным публикациям</small>
            </div>
            <div class="ws-stat">
                <span>Текущая процедура</span>
                <strong>@CurrentProcedure</strong>
                <small>по судебным актам и отчетам</small>
            </div>
        </section>

        <section class="ws-controls">
            <label>
                Вид доски
                <select value="@viewMode" @onchange="OnModeChanged">
                    <option value="process">По разделам</option>
                    <option value="chains">Цепочки</option>
                    <option value="timeline">Хронология</option>
                    <option value="newest">Сначала новые</option>
                </select>
            </label>

            <label>
                Масштаб
                <select value="@density" @onchange="OnDensityChanged">
                    <option value="normal">Обычный</option>
                    <option value="compact">Компактный</option>
                    <option value="wide">Широкий</option>
                </select>
            </label>

            <label class="ws-check">
                <input type="checkbox" checked="@showOnlyUnread" @onchange="OnUnreadFilterChanged" />
                Только непрочитанные
            </label>

            <label class="ws-check">
                <input type="checkbox" checked="@showEdges" @onchange="OnShowEdgesChanged" />
                Показывать связи
            </label>

            <div class="ws-help">
                Перетаскивай карточки мышкой. Тяни пустое поле, чтобы двигать доску. Колесо мыши меняет масштаб.
            </div>
        </section>

        <section class="ws-notes-panel">
            <div>
                <h2>Заметки по компании</h2>
                <p>Черновик хранится в браузере пользователя. Позже можно перенести в БД отдельной миграцией.</p>
            </div>
            <textarea data-ws-note="@CompanyNoteKey" placeholder="Общие заметки по делу: что проверить, какие публикации важны, выводы по процедуре..."></textarea>
        </section>

        @if (KeyEvents.Count > 0)
        {
            <section class="ws-events">
                <div class="ws-section-title">
                    <h2>Ключевые события</h2>
                    <span>судебные акты и отчеты</span>
                </div>
                <div class="ws-events-row">
                    @foreach (var item in KeyEvents)
                    {
                        <a class="ws-event-pill" href="@($"/messages/{item.Id}")">
                            <strong>@item.DatePublish.ToLocalTime().ToString("dd.MM.yyyy")</strong>
                            <span>@GetTypeTitle(item.Type, item.CourtDecisionType)</span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="ws-canvas-shell">
            <div class="ws-canvas-topbar">
                <div>
                    <strong>2D-доска</strong>
                    <span>@nodes.Count карточек, @edges.Count связей</span>
                </div>
                <div class="ws-legend">
                    <span><i class="legend-dot unread"></i> новое</span>
                    <span><i class="legend-dot locked"></i> заблокировано</span>
                    <span><i class="legend-dot annulled"></i> аннулировано</span>
                    <span><i class="legend-dot violation"></i> нарушение срока</span>
                </div>
            </div>

            <div id="@WorkspaceDomId" class="ws-viewport" data-ws-root data-ws-view-key="@ViewKey">
                <div class="ws-canvas" data-ws-canvas style="@CanvasStyle(nodes)">
                    <svg class="ws-edges" data-ws-edges style="@CanvasStyle(nodes)">
                        <defs>
                            <marker id="ws-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
                                <path d="M0,0 L0,6 L9,3 z" class="ws-arrow-head" />
                            </marker>
                        </defs>
                        @if (showEdges)
                        {
                            @foreach (var edge in edges)
                            {
                                <path data-ws-edge data-from="@edge.FromNodeId" data-to="@edge.ToNodeId" class="@edge.CssClass" />
                            }
                        }
                    </svg>

                    @foreach (var group in GroupPanels(nodes))
                    {
                        <div class="ws-group-panel @group.CssClass" style="@GroupPanelStyle(group)">
                            <h3>@group.Title</h3>
                            <span>@group.Count сообщений</span>
                        </div>
                    }

                    @foreach (var node in nodes)
                    {
                        <article class="ws-node @node.CssClass @(node.Message.IsRead ? "" : "is-unread")"
                                 data-ws-card
                                 data-ws-node-id="@node.NodeId"
                                 data-ws-position-key="@node.PositionKey"
                                 data-ws-default-left="@node.X"
                                 data-ws-default-top="@node.Y"
                                 style="@NodeStyle(node)">
                            <div class="ws-node-head">
                                <a href="@($"/messages/{node.Message.Id}")">@node.Message.Number</a>
                                <span>@node.Message.DatePublish.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>

                            <h3>@node.Title</h3>

                            <div class="ws-node-meta">
                                <span>@node.Group</span>
                                <span>#@node.Sequence</span>
                            </div>

                            <div class="ws-badges">
                                @if (!node.Message.IsRead)
                                {
                                    <span class="ws-badge badge-unread">Новое</span>
                                }
                                @if (node.Message.IsLocked)
                                {
                                    <span class="ws-badge badge-locked">Заблокировано</span>
                                }
                                @if (node.Message.IsAnnulled)
                                {
                                    <span class="ws-badge badge-annulled">Аннулировано</span>
                                }
                                @if (node.Message.HasViolation == true)
                                {
                                    <span class="ws-badge badge-violation">Нарушение срока</span>
                                }
                            </div>

                            <textarea data-ws-note="@node.NoteKey" placeholder="Заметка к сообщению..."></textarea>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public Guid CompanyId { get; set; }

    private TrackedCompanyDto? company;
    private IReadOnlyList<EfrsbMessageDto>? messages;
    private string? error;
    private string? status;
    private bool isBusy;
    private bool showOnlyUnread;
    private bool showEdges = true;
    private string viewMode = "process";
    private string density = "normal";
    private CancellationTokenSource? refreshCts;
    private bool disposed;
    private bool scriptReady;
    private DateTime autoRefreshUntilUtc = DateTime.UtcNow.AddMinutes(1);

    private string WorkspaceDomId => $"worksheet-space-{CompanyId:N}";
    private string ViewKey => $"efrsb:worksheet:{CompanyId:N}:view";
    private string CompanyNoteKey => $"efrsb:worksheet:{CompanyId:N}:company-note";

    private IReadOnlyList<EfrsbMessageDto> Messages => messages?.ToList() ?? Array.Empty<EfrsbMessageDto>();

    private IReadOnlyList<EfrsbMessageDto> VisibleMessages
    {
        get
        {
            IEnumerable<EfrsbMessageDto> query = Messages;

            if (showOnlyUnread)
                query = query.Where(x => !x.IsRead);

            return viewMode switch
            {
                "timeline" => query.OrderBy(x => x.DatePublish).ToList(),
                "newest" => query.OrderByDescending(x => x.DatePublish).ToList(),
                _ => query.OrderBy(x => x.DatePublish).ToList()
            };
        }
    }

    private IReadOnlyList<EfrsbMessageDto> KeyEvents => Messages
        .Where(x => IsCourtEvent(x) || x.Type.StartsWith("Report:", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.DatePublish)
        .Take(10)
        .ToList();

    private string CurrentProcedure
    {
        get
        {
            var latestCourt = Messages
                .Where(IsCourtEvent)
                .OrderByDescending(x => x.DatePublish)
                .FirstOrDefault();

            var title = latestCourt is null ? null : GetTypeTitle(latestCourt.Type, latestCourt.CourtDecisionType);

            if (string.IsNullOrWhiteSpace(title))
                return "Не определена";

            if (title.Contains("конкурс", StringComparison.OrdinalIgnoreCase)) return "Конкурсное производство";
            if (title.Contains("наблюден", StringComparison.OrdinalIgnoreCase)) return "Наблюдение";
            if (title.Contains("внеш", StringComparison.OrdinalIgnoreCase)) return "Внешнее управление";
            if (title.Contains("реструктур", StringComparison.OrdinalIgnoreCase)) return "Реструктуризация долгов";
            if (title.Contains("реализац", StringComparison.OrdinalIgnoreCase)) return "Реализация имущества";

            return title;
        }
    }

    private IReadOnlyList<WorksheetNode> Nodes => BuildNodes();

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshCts = new CancellationTokenSource();
        _ = RefreshLoop(refreshCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (company is not null)
        {
            await EnsureWorksheetScript();
            await JS.InvokeVoidAsync("efrsbWorksheet2d.init", WorkspaceDomId);
        }
    }

    public void Dispose()
    {
        disposed = true;
        refreshCts?.Cancel();
        refreshCts?.Dispose();
    }

    private async Task<Guid> GetUserId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var value = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(value))
            throw new InvalidOperationException("Пользователь не авторизован.");

        return Guid.Parse(value);
    }

    private async Task RefreshLoop(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && !disposed)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);

                if (cancellationToken.IsCancellationRequested || disposed)
                    break;

                if (!ShouldPoll())
                    continue;

                await InvokeAsync(async () =>
                {
                    if (disposed)
                        return;

                    await Load(silent: true);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Фоновое автообновление не должно ронять рабочую доску.
            }
        }
    }

    private bool ShouldPoll()
    {
        if (isBusy || DateTime.UtcNow <= autoRefreshUntilUtc)
            return true;

        return company is not null && company.TotalMessages > 0 && company.LoadedMessages < company.TotalMessages;
    }

    private async Task Load(bool silent = false)
    {
        if (!silent)
            error = null;

        try
        {
            var userId = await GetUserId();
            var companies = await CompanyService.GetCompaniesAsync(userId, CancellationToken.None);
            company = companies.FirstOrDefault(x => x.Id == CompanyId);

            if (company is null)
            {
                if (!silent)
                    error = "Компания не найдена или нет доступа.";
                return;
            }

            messages = await CompanyService.GetMessagesAsync(userId, CompanyId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (!silent)
                error = ex.Message;
        }
    }

    private async Task MarkAllRead()
    {
        error = null;
        isBusy = true;
        status = "Помечаем сообщения прочитанными...";

        try
        {
            var userId = await GetUserId();
            var changed = await CompanyService.MarkCompanyMessagesReadAsync(userId, CompanyId, CancellationToken.None);
            status = changed == 0 ? "Непрочитанных сообщений не было." : $"Прочитано сообщений: {changed}.";
            autoRefreshUntilUtc = DateTime.UtcNow.AddSeconds(10);
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        viewMode = e.Value?.ToString() ?? "process";
        await ResetPositions();
    }

    private async Task OnDensityChanged(ChangeEventArgs e)
    {
        density = e.Value?.ToString() ?? "normal";
        await ResetPositions();
    }

    private Task OnUnreadFilterChanged(ChangeEventArgs e)
    {
        showOnlyUnread = e.Value is bool value && value;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnShowEdgesChanged(ChangeEventArgs e)
    {
        showEdges = e.Value is bool value && value;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ResetPositions()
    {
        await EnsureWorksheetScript();
        await JS.InvokeVoidAsync("efrsbWorksheet2d.resetPositions", WorkspaceDomId);
    }

    private async Task ResetView()
    {
        await EnsureWorksheetScript();
        await JS.InvokeVoidAsync("efrsbWorksheet2d.resetView", WorkspaceDomId);
    }

    private async Task FitView()
    {
        await EnsureWorksheetScript();
        await JS.InvokeVoidAsync("efrsbWorksheet2d.fit", WorkspaceDomId);
    }

    private IReadOnlyList<WorksheetNode> BuildNodes()
    {
        var items = VisibleMessages.ToList();
        var result = new List<WorksheetNode>(items.Count);
        var size = GetNodeSize();
        var groups = GetGroupOrder(items);

        if (viewMode == "timeline" || viewMode == "newest")
        {
            var ordered = viewMode == "newest"
                ? items.OrderByDescending(x => x.DatePublish).ToList()
                : items.OrderBy(x => x.DatePublish).ToList();

            for (var i = 0; i < ordered.Count; i++)
            {
                var item = ordered[i];
                var group = GetWorksheetGroupTitle(item);
                var lane = Math.Max(0, groups.IndexOf(group));
                var x = 160 + i * (size.Width + 70);
                var y = 170 + lane * (size.Height + 90);

                result.Add(ToNode(item, group, x, y, size, i + 1));
            }

            return result;
        }

        for (var groupIndex = 0; groupIndex < groups.Count; groupIndex++)
        {
            var group = groups[groupIndex];
            var groupItems = items
                .Where(x => GetWorksheetGroupTitle(x) == group)
                .OrderBy(x => x.DatePublish)
                .ToList();

            for (var itemIndex = 0; itemIndex < groupItems.Count; itemIndex++)
            {
                var x = 160 + groupIndex * (size.Width + 160);
                var y = 190 + itemIndex * (size.Height + 70);

                if (viewMode == "chains")
                {
                    // Небольшая шахматная раскладка делает цепочку визуально читаемой.
                    x += itemIndex % 2 == 0 ? 0 : 42;
                }

                result.Add(ToNode(groupItems[itemIndex], group, x, y, size, itemIndex + 1));
            }
        }

        return result;
    }

    private WorksheetNode ToNode(EfrsbMessageDto item, string group, int x, int y, NodeSize size, int sequence)
    {
        return new WorksheetNode(
            NodeId: $"node-{item.Id:N}",
            Message: item,
            Group: group,
            Title: GetTypeTitle(item.Type, item.CourtDecisionType),
            X: x,
            Y: y,
            Width: size.Width,
            Height: size.Height,
            NoteKey: $"efrsb:worksheet:{CompanyId:N}:note:{item.Id:N}",
            PositionKey: $"efrsb:worksheet:{CompanyId:N}:pos:{viewMode}:{density}:{item.Id:N}",
            CssClass: CssClassForGroup(group),
            Sequence: sequence);
    }

    private IReadOnlyList<WorksheetEdge> Edges(IReadOnlyList<WorksheetNode> nodes)
    {
        var edges = new List<WorksheetEdge>();

        foreach (var group in nodes.GroupBy(x => x.Group))
        {
            var ordered = group.OrderBy(x => x.Message.DatePublish).ToList();
            for (var i = 0; i < ordered.Count - 1; i++)
            {
                edges.Add(new WorksheetEdge(
                    ordered[i].NodeId,
                    ordered[i + 1].NodeId,
                    CssClassForEdge(group.Key)));
            }
        }

        AddSemanticEdges(nodes, edges);
        return edges
            .DistinctBy(x => $"{x.FromNodeId}:{x.ToNodeId}")
            .ToList();
    }

    private static void AddSemanticEdges(IReadOnlyList<WorksheetNode> nodes, List<WorksheetEdge> edges)
    {
        var ordered = nodes.OrderBy(x => x.Message.DatePublish).ToList();

        foreach (var node in ordered)
        {
            var title = node.Title;
            var type = node.Message.Type;

            if (ContainsAny(type, title, "Meeting", "собрани"))
            {
                var target = ordered.FirstOrDefault(x =>
                    x.Message.DatePublish > node.Message.DatePublish &&
                    ContainsAny(x.Message.Type, x.Title, "MeetingResult", "CommitteeResult", "результат", "решени"));

                if (target is not null)
                    edges.Add(new WorksheetEdge(node.NodeId, target.NodeId, "edge-semantic"));
            }

            if (ContainsAny(type, title, "DealInvalid", "заявление о признании сделки"))
            {
                var target = ordered.FirstOrDefault(x =>
                    x.Message.DatePublish > node.Message.DatePublish &&
                    ContainsAny(x.Message.Type, x.Title, "ActDeal", "ActReview", "результаты рассмотрения", "пересмотра"));

                if (target is not null)
                    edges.Add(new WorksheetEdge(node.NodeId, target.NodeId, "edge-semantic"));
            }
        }
    }

    private List<string> GetGroupOrder(IEnumerable<EfrsbMessageDto> items)
    {
        var knownOrder = new[]
        {
            "Судебные акты",
            "Отчеты АУ",
            "Собрания кредиторов",
            "Требования кредиторов",
            "Оспаривание сделок",
            "Инвентаризация имущества",
            "Работники должника",
            "Торги и имущество",
            "Аннулирование",
            "Прочее"
        };

        var actual = items
            .Select(GetWorksheetGroupTitle)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return knownOrder
            .Where(actual.Contains)
            .Concat(actual.Where(x => !knownOrder.Contains(x, StringComparer.OrdinalIgnoreCase)).OrderBy(x => x))
            .ToList();
    }

    private IReadOnlyList<WorksheetGroupPanel> GroupPanels(IReadOnlyList<WorksheetNode> nodes)
    {
        return nodes
            .GroupBy(x => x.Group)
            .Select(group =>
            {
                var minX = group.Min(x => x.X) - 34;
                var minY = group.Min(x => x.Y) - 68;
                var maxX = group.Max(x => x.X + x.Width) + 54;
                var maxY = group.Max(x => x.Y + x.Height) + 70;

                return new WorksheetGroupPanel(
                    Title: group.Key,
                    X: minX,
                    Y: minY,
                    Width: maxX - minX,
                    Height: maxY - minY,
                    Count: group.Count(),
                    CssClass: CssClassForGroup(group.Key));
            })
            .ToList();
    }

    private NodeSize GetNodeSize()
    {
        return density switch
        {
            "compact" => new NodeSize(250, 168),
            "wide" => new NodeSize(360, 230),
            _ => new NodeSize(300, 205)
        };
    }

    private static string NodeStyle(WorksheetNode node)
    {
        return $"left:{node.X}px;top:{node.Y}px;width:{node.Width}px;min-height:{node.Height}px;";
    }

    private static string GroupPanelStyle(WorksheetGroupPanel group)
    {
        return $"left:{group.X}px;top:{group.Y}px;width:{group.Width}px;height:{group.Height}px;";
    }

    private static string CanvasStyle(IReadOnlyList<WorksheetNode> nodes)
    {
        var width = Math.Max(2400, nodes.Count == 0 ? 2400 : nodes.Max(x => x.X + x.Width + 520));
        var height = Math.Max(1500, nodes.Count == 0 ? 1500 : nodes.Max(x => x.Y + x.Height + 420));
        return $"width:{width}px;height:{height}px;";
    }

    private static bool IsCourtEvent(EfrsbMessageDto item)
    {
        return item.Type.Equals("ArbitralDecree", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetWorksheetGroupTitle(EfrsbMessageDto item)
    {
        var type = item.Type.StartsWith("Report:", StringComparison.OrdinalIgnoreCase) ? "Report" : item.Type;
        var title = GetTypeTitle(item.Type, item.CourtDecisionType);

        if (type.Equals("ArbitralDecree", StringComparison.OrdinalIgnoreCase)) return "Судебные акты";
        if (item.Type.StartsWith("Report:", StringComparison.OrdinalIgnoreCase)) return "Отчеты АУ";
        if (ContainsAny(type, title, "Meeting", "Committee", "собрани", "комитет")) return "Собрания кредиторов";
        if (ContainsAny(type, title, "Demand", "Creditor", "требован", "кредитор")) return "Требования кредиторов";
        if (ContainsAny(type, title, "DealInvalid", "ActDeal", "ActReview", "оспарив", "сделк", "убытк")) return "Оспаривание сделок";
        if (ContainsAny(type, title, "Inventory", "инвентаризац")) return "Инвентаризация имущества";
        if (ContainsAny(type, title, "Worker", "работник")) return "Работники должника";
        if (ContainsAny(type, title, "Auction", "Trade", "Sale", "торг", "продаж")) return "Торги и имущество";
        if (ContainsAny(type, title, "Annul", "аннулир")) return "Аннулирование";

        return "Прочее";
    }

    private static string CssClassForGroup(string group)
    {
        return group switch
        {
            "Судебные акты" => "group-court",
            "Отчеты АУ" => "group-report",
            "Собрания кредиторов" => "group-meeting",
            "Требования кредиторов" => "group-demand",
