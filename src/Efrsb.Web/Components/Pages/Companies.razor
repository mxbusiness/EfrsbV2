@page "/companies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]

@using System.Security.Claims
@using Efrsb.Application.Abstractions
@using Efrsb.Contracts.Companies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inject ICompanyTrackingService CompanyService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<h1>Отслеживаемые компании</h1>

<div class="card">
    <input @bind="query" placeholder="ИНН / ОГРН / название / GUID" />
    <button @onclick="Add">Добавить</button>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="muted">@status</p>
}

@if (companies is null)
{
    <p>Загрузка...</p>
}
else if (companies.Count == 0)
{
    <p>Компаний пока нет.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Компания</th>
                <th>ИНН / ОГРН</th>
                <th>BankruptGuid</th>
                <th>Непрочитанные</th>
                <th>Загружено</th>
                <th>Всего в ЕФРСБ</th>
                <th>Первая публикация</th>
                <th>Последняя публикация</th>
                <th>Синхронизация</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in companies)
            {
                <tr>
                    <td>@(c.Name ?? c.SearchQuery)</td>
                    <td>@c.Inn / @c.Ogrn</td>
                    <td>@c.BankruptGuid</td>
                    <td>@c.UnreadCount</td>
                    <td>@c.LoadedMessages</td>
                    <td>@c.TotalMessages</td>
                    <td>@FormatDate(c.FirstMessageDate)</td>
                    <td>@FormatDate(c.LastMessageDate)</td>
                    <td>@FormatDate(c.LastSyncedAtUtc)</td>
                    <td class="actions-cell">
                        <a href="@($"/companies/{c.Id}/messages")">Сообщения</a>
                        <button @onclick="() => Sync(c.Id)">Обновить</button>
                        <button class="danger" @onclick="() => Delete(c.Id)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<TrackedCompanyDto>? companies;
    private string query = string.Empty;
    private string? error;
    private string? status;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task<Guid> GetUserId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var value = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(value))
            throw new InvalidOperationException("Пользователь не авторизован.");

        return Guid.Parse(value);
    }

    private async Task Load()
    {
        var userId = await GetUserId();
        companies = await CompanyService.GetCompaniesAsync(userId, CancellationToken.None);
    }

    private async Task Add()
    {
        error = null;
        status = "Добавляем компанию...";

        try
        {
            if (string.IsNullOrWhiteSpace(query))
            {
                status = null;
                return;
            }

            var userId = await GetUserId();

            await CompanyService.AddCompanyAsync(
                userId,
                query,
                CancellationToken.None);

            query = string.Empty;
            status = "Компания добавлена.";

            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
    }

    private async Task Sync(Guid id)
    {
        error = null;
        status = "Синхронизация...";

        try
        {
            var userId = await GetUserId();

            await CompanyService.SyncCompanyAsync(
                userId,
                id,
                CancellationToken.None);

            status = "Синхронизация завершена.";

            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
    }

    private async Task Delete(Guid id)
    {
        error = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Удалить компанию из отслеживания? Все загруженные сообщения по ней тоже будут удалены.");

        if (!confirmed)
            return;

        status = "Удаляем компанию...";

        try
        {
            var userId = await GetUserId();

            await CompanyService.DeleteCompanyAsync(
                userId,
                id,
                CancellationToken.None);

            status = "Компания удалена.";

            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            : "-";
    }
}