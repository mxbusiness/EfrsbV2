@page "/companies"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]

@using System.Security.Claims
@using Efrsb.Application.Abstractions
@using Efrsb.Contracts.Companies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject ICompanyTrackingService CompanyService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<h1>Отслеживаемые компании</h1>

<div class="card">
    <div class="row-wrap">
        <input @bind="query" @bind:event="oninput" placeholder="ИНН / ОГРН / название / GUID" disabled="@isBusy" />
        <button @onclick="Add" disabled="@(isBusy || string.IsNullOrWhiteSpace(query))">Добавить</button>
    </div>
    <p class="muted">После добавления карточка компании и история публикаций автоматически подтягиваются из ЕФРСБ.</p>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="muted">@status</p>
}

@if (companies is null)
{
    <p>Загрузка...</p>
}
else if (companies.Count == 0)
{
    <p>Компаний пока нет.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Компания</th>
                <th>ИНН / ОГРН</th>
                <th>Непрочитанные</th>
                <th>Загружено</th>
                <th>Всего в ЕФРСБ</th>
                <th>Последняя публикация</th>
                <th>Синхронизация</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in companies)
            {
                <tr>
                    <td>
                        <a href="@($"/companies/{c.Id}")" class="company-link">
                            @(c.Name ?? c.SearchQuery)
                        </a>
                        @if (!string.IsNullOrWhiteSpace(c.BankruptGuid))
                        {
                            <div class="muted small">@c.BankruptGuid</div>
                        }
                    </td>
                    <td>@DisplayPair(c.Inn, c.Ogrn)</td>
                    <td>@c.UnreadCount</td>
                    <td>@c.LoadedMessages</td>
                    <td>@c.TotalMessages</td>
                    <td>@FormatDate(c.LastMessageDate)</td>
                    <td>@FormatDate(c.LastSyncedAtUtc)</td>
                    <td class="actions-cell">
                        <button class="danger" @onclick="() => Delete(c.Id)" disabled="@isBusy">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<TrackedCompanyDto>? companies;
    private string query = string.Empty;
    private string? error;
    private string? status;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task<Guid> GetUserId()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var value = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(value))
            throw new InvalidOperationException("Пользователь не авторизован.");

        return Guid.Parse(value);
    }

    private async Task Load()
    {
        var userId = await GetUserId();
        companies = await CompanyService.GetCompaniesAsync(userId, CancellationToken.None);
    }

    private async Task Add()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(query))
            return;

        isBusy = true;
        status = "Добавляем компанию и загружаем данные из ЕФРСБ...";

        try
        {
            var userId = await GetUserId();
            var company = await CompanyService.AddCompanyAsync(userId, query.Trim(), CancellationToken.None);

            status = "Компания добавлена. Догружаем историю публикаций...";
            var loaded = await CompanyService.SyncCompanyHistoryAsync(userId, company.Id, CancellationToken.None);

            query = string.Empty;
            status = $"Компания добавлена. Загружено новых сообщений: {loaded}.";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task Delete(Guid id)
    {
        error = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Удалить компанию из отслеживания? Все загруженные сообщения по ней тоже будут удалены.");

        if (!confirmed)
            return;

        isBusy = true;
        status = "Удаляем компанию...";

        try
        {
            var userId = await GetUserId();
            await CompanyService.DeleteCompanyAsync(userId, id, CancellationToken.None);

            status = "Компания удалена.";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            status = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string DisplayPair(string? left, string? right)
    {
        var a = string.IsNullOrWhiteSpace(left) ? "-" : left;
        var b = string.IsNullOrWhiteSpace(right) ? "-" : right;
        return $"{a} / {b}";
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            : "-";
    }
}
