@page "/messages/{MessageId:guid}"
@attribute [Authorize]
@inject HttpClient Http
@using Efrsb.Contracts.Messages
<h1>Сообщение</h1>
@if(message is null){<p>Загрузка...</p>} else {
<div class="card"><h2>@message.Number — @message.Type</h2><p>@message.DatePublish</p><p>GUID: @message.FedresursGuid</p><button @onclick="MarkRead">Отметить прочитанным</button></div>
<div class="card"><h3>Файлы</h3>@foreach(var f in message.Files){<p>@f.FileName (@f.SizeBytes байт)</p>}</div>
<div class="card"><h3>XML</h3><pre>@message.ContentXml</pre></div>}
@code{
[Parameter] public Guid MessageId {get;set;}
private EfrsbMessageDetailsDto? message;
protected override async Task OnInitializedAsync(){ await Load(); }
private async Task Load(){ message = await Http.GetFromJsonAsync<EfrsbMessageDetailsDto>($"/api/messages/{MessageId}"); }
private async Task MarkRead(){ await Http.PostAsync($"/api/messages/{MessageId}/read", null); await Load(); }
}
