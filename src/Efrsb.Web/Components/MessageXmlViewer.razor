@using System.Xml.Linq
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="xml-viewer">
    <div class="xml-toolbar">
        <button class="xml-btn @(structuredView ? "active" : "")"
                @onclick="() => structuredView = true">
            Приведённый вид
        </button>

        <button class="xml-btn @(!structuredView ? "active" : "")"
                @onclick="() => structuredView = false">
            Оригинальный XML
        </button>

        <button class="xml-btn" @onclick="CopyXml">
            Копировать XML
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(parseError))
    {
        <div class="info-block">
            <h3>XML</h3>
            <p class="muted">Не удалось разобрать XML. Показан оригинальный текст.</p>
        </div>

        <pre>@XmlContent</pre>
    }
    else if (structuredView)
    {
        <div class="structured-view">
            <div class="info-block">
                <h3>Дело</h3>
                @InfoRow("Номер дела", GetValue("CaseNumber"))
            </div>

            <div class="info-block">
                <h3>Должник</h3>
                @InfoRow("Название", GetValue("Bankrupt/Name"))
                @InfoRow("ИНН", GetValue("Bankrupt/Inn"))
                @InfoRow("ОГРН", GetValue("Bankrupt/Ogrn"))
                @InfoRow("Адрес", GetValue("Bankrupt/Address"))
                @InfoRow("Категория", GetValue("Bankrupt/Category/Description"))
            </div>

            <div class="info-block">
                <h3>Публикатор</h3>
                @InfoRow("ФИО", GetFio("Publisher/Fio"))
                @InfoRow("ИНН", GetValue("Publisher/Inn"))
                @InfoRow("СНИЛС", GetValue("Publisher/Snils"))
                @InfoRow("Адрес", GetValue("Publisher/CorrespondenceAddress"))
                @InfoRow("Email", GetValue("Publisher/Email"))
            </div>

            <div class="info-block">
                <h3>СРО</h3>
                @InfoRow("Название", GetValue("Publisher/Sro/Name"))
                @InfoRow("ИНН", GetValue("Publisher/Sro/Inn"))
                @InfoRow("ОГРН", GetValue("Publisher/Sro/Ogrn"))
                @InfoRow("Адрес", GetValue("Publisher/Sro/Address"))
            </div>

            <div class="info-block xml-full-block">
                <h3>Сообщение</h3>
                @InfoRow("Тип", MessageType)
            </div>

            @foreach (var node in GetMessageContentNodes())
            {
                <div class="info-block xml-full-block">
                    <h3>@FriendlyName(node.Name.LocalName)</h3>
                    @RenderXmlNode(node)
                </div>
            }
        </div>
    }
    else
    {
        <pre>@FormattedXml</pre>
    }
</div>

@code {
    [Parameter]
    public string XmlContent { get; set; } = string.Empty;

    private bool structuredView = true;
    private XDocument? document;
    private string? parseError;

    private string MessageType =>
        document?
            .Root?
            .Element("MessageInfo")?
            .Attribute("MessageType")?
            .Value
            ?? "-";

    private string FormattedXml
    {
        get
        {
            if (document is null)
                return XmlContent;

            return document.ToString(SaveOptions.None);
        }
    }

    protected override void OnParametersSet()
    {
        parseError = null;
        document = null;

        if (string.IsNullOrWhiteSpace(XmlContent))
            return;

        try
        {
            document = XDocument.Parse(XmlContent, LoadOptions.PreserveWhitespace);
        }
        catch (Exception ex)
        {
            parseError = ex.Message;
        }
    }

    private IEnumerable<XElement> GetMessageContentNodes()
    {
        return document?
            .Root?
            .Element("MessageInfo")?
            .Elements()
            ?? Enumerable.Empty<XElement>();
    }

    private string GetValue(string path)
    {
        XElement? current = document?.Root;

        foreach (var part in path.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            if (current is null)
                return "-";

            current = current.Element(part);
        }

        if (current is null)
            return "-";

        var value = NormalizeText(current.Value);

        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private string GetFio(string path)
    {
        XElement? current = document?.Root;

        foreach (var part in path.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            if (current is null)
                return "-";

            current = current.Element(part);
        }

        if (current is null)
            return "-";

        var parts = new[]
        {
            current.Element("LastName")?.Value,
            current.Element("FirstName")?.Value,
            current.Element("MiddleName")?.Value
        }
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x!.Trim());

        var fio = string.Join(" ", parts);

        return string.IsNullOrWhiteSpace(fio)
            ? "-"
            : fio;
    }

    private RenderFragment InfoRow(string label, string? value) => builder =>
    {
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "info-row");

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "label");
        builder.AddContent(seq++, label);
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, string.IsNullOrWhiteSpace(value) ? "-" : value);
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment RenderXmlNode(XElement element, int level = 0) => builder =>
    {
        var seq = 0;
        var children = element.Elements().ToList();
        var hasChildren = children.Count > 0;
        var directText = NormalizeText(string.Concat(element.Nodes().OfType<XText>().Select(x => x.Value)));

        if (!hasChildren)
        {
            var value = NormalizeText(element.Value);

            if (string.IsNullOrWhiteSpace(value))
                return;

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", value.Length > 300 ? "xml-leaf-row xml-long-row" : "xml-leaf-row");

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "label");
            builder.AddContent(seq++, FriendlyName(element.Name.LocalName));
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", value.Length > 300 ? "xml-long-text" : "");
            builder.AddContent(seq++, value);
            builder.CloseElement();

            builder.CloseElement();

            return;
        }

        builder.OpenElement(seq++, "details");
        builder.AddAttribute(seq++, "class", "xml-details");
        builder.AddAttribute(seq++, "open", level < 3);

        builder.OpenElement(seq++, "summary");
        builder.AddContent(seq++, FriendlyName(element.Name.LocalName));

        var attrs = element.Attributes()
            .Where(x => !x.IsNamespaceDeclaration)
            .ToList();

        foreach (var attr in attrs)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "xml-attr");
            builder.AddContent(seq++, $"{attr.Name.LocalName}: {attr.Value}");
            builder.CloseElement();
        }

        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(directText))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "xml-direct-text");
            builder.AddContent(seq++, directText);
            builder.CloseElement();
        }

        foreach (var child in children)
            builder.AddContent(seq++, RenderXmlNode(child, level + 1));

        builder.CloseElement();
    };

    private static string NormalizeText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return value
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Trim();
    }

    private static string FriendlyName(string name)
    {
        return name switch
        {
            "Text" => "Текст сообщения",
            "Act" => "Сведения об акте",
            "LegalCaseNumber" => "Номер дела",
            "DecisionDate" => "Дата вынесения",
            "Deals" => "Сделки",
            "Deal" => "Сделка",
            "Participants" => "Участники",
            "Participant" => "Участник",
            "ContestingReasons" => "Основания оспаривания",
            "Reason" => "Основание",
            "Result" => "Результат",
            "SatisfiedSum" => "Сумма удовлетворения",
            "Comment" => "Комментарий",
            "Description" => "Описание",
            "Code" => "Код",
            "Name" => "Название",
            "Inn" => "ИНН",
            "Ogrn" => "ОГРН",
            "Ogrnip" => "ОГРНИП",
            "Snils" => "СНИЛС",
            "Address" => "Адрес",
            "Email" => "Email",
            "Fio" => "ФИО",
            "LastName" => "Фамилия",
            "FirstName" => "Имя",
            "MiddleName" => "Отчество",
            "Type" => "Тип",
            "Guid" => "GUID",
            "DateApplication" => "Дата подачи заявления",
            "IsApplicantArbitrManager" => "Заявитель — арбитражный управляющий",
            "IsWithoutPrice" => "Цена отсутствует",
            "DealInvalidMessageNumber" => "Номер сообщения об оспаривании",
            "MeetingForm" => "Форма собрания",
            "Place" => "Место",
            "Date" => "Дата",
            "Time" => "Время",
            "Agenda" => "Повестка",
            "Decision" => "Решение",
            "Procedure" => "Процедура",
            "ProcedureType" => "Тип процедуры",
            "Report" => "Отчёт",
            "Amount" => "Сумма",
            "Creditor" => "Кредитор",
            "Debtor" => "Должник",
            "Publisher" => "Публикатор",
            "Bankrupt" => "Должник",
            "MessageInfo" => "Сообщение",
            _ => name
        };
    }

    private async Task CopyXml()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", XmlContent);
    }
}